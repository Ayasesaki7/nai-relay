# ===== 必填 =====
# 你的域名（DNS 先解析到服务器），Caddy 会自动申请 HTTPS 证书
DOMAIN=nai.example.com

# NAI 持久 API Token：官网 -> Account Settings -> Get Persistent API Token（pst- 开头）
NAI_TOKEN=pst-xxxxxxxxxxxxxxxxxxxxxxxx

# 中转用户，格式 名字:key，多个用逗号分隔。key 用 `openssl rand -hex 24` 生成
PROXY_KEYS=alice:sk-change-me-xxxxxxxxxxxxxxxx,bob:sk-change-me-yyyyyyyyyyyyyyyy

# ===== 可选 =====
# 排队最多等多久（秒），超时返回 503
#QUEUE_TIMEOUT=300
# 两次生成之间最少间隔，再加 0~JITTER 秒随机
#MIN_INTERVAL=1.0
#JITTER=1.5

# 发往 NAI 的固定 UA / Origin
#USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36
#ORIGIN=https://novelai.net

# 日志保留天数；是否在日志里记录提示词（默认不记，避免互相看到对方的 prompt）
#LOG_RETENTION_DAYS=30
#LOG_PROMPT=false
#LOG_PROMPT_MAX=300

#UPSTREAM_TIMEOUT=300
#MAX_BODY_MB=50

# 云端图库每人可用空间（MB），默认 5120 = 5 GB
#GALLERY_QUOTA_MB=5120

# 参考素材库（氛围 / 角色参考）每人可用空间（MB），默认 1024 = 1 GB
#ASSET_QUOTA_MB=1024

# 灵感画廊：Gelbooru 现在必须带 API key 才能搜（在 Gelbooru 账号设置页的 Options 里能看到），
# 两项都填了才会出现 Gelbooru；Danbooru 和 Safebooru 不用配置
#GELBOORU_API_KEY=
#GELBOORU_USER_ID=

# 生图助手：大模型连接（含 key）保存的位置，默认 data/agent.json
#AGENT_FILE=/app/data/agent.json
